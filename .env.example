# Copy to .env.local for development, and set the same values in Vercel → Settings → Environment Variables.

# Measurement
# App Store Connect → Analytics → Sources → Campaigns → "Generate a campaign link": the pt=… value.
NEXT_PUBLIC_APP_STORE_PROVIDER_TOKEN=
# Google Search Console → Add property → HTML tag: the content="…" value only.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Add site → HTML meta tag: the content="…" value only.
BING_SITE_VERIFICATION=

# Blog (Sanity). From https://www.sanity.io/manage → your project. Leave empty and the blog shows as "coming soon".
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Any long random string. Sanity's publish webhook sends it as "Authorization: Bearer <secret>" to /api/revalidate.
SANITY_REVALIDATE_SECRET=
